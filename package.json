{
  "type": "module",
  "private": "true",
  "version": "0.0.0",
  "main": "public/index.js",
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js}\"",
    "stylelint": "stylelint \"**/*.css\" --ignore-pattern \"public/**\"",
    "test": "esbuild ./test/index.ts --bundle --keep-names | tapout",
    "test-a11y": "playwright test",
    "test-a11y:ui": "playwright test --ui",
    "test-a11y:headed": "playwright test --headed",
    "test-a11y:debug": "playwright test --debug",
    "test-all": "npm run test && npm run test-a11y",
    "build": "mkdir -p ./public && rm -rf ./public/* && vite build",
    "start": "concurrently --kill-others \"npx ntl functions:serve --port=9999\" \"npx vite\"",
    "preversion": "npm run lint",
    "version": "auto-changelog --template keepachangelog --breaking-pattern 'BREAKING CHANGE' && git add CHANGELOG.md",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@preact/signals": "^2.9.1",
    "@substrate-system/a11y": "^0.0.17",
    "@substrate-system/css-normalize": "^0.0.15",
    "@substrate-system/hamburger-two": "^0.0.13",
    "@substrate-system/routes": "^5.0.5",
    "htm": "^3.1.1",
    "ky": "^2.0.2",
    "preact": "^10.29.2",
    "route-event": "^8.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@netlify/functions": "^5.2.2",
    "@playwright/test": "^1.60.0",
    "@preact/preset-vite": "^2.10.5",
    "@substrate-system/debug": "^0.9.64",
    "@substrate-system/tapout": "^0.0.37",
    "@substrate-system/tapzero": "^0.10.15",
    "@substrate-system/wait-on": "^8.0.3",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.8.1",
    "auto-changelog": "^2.5.1",
    "browserslist": "^4.28.2",
    "concurrently": "^9.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "lightningcss": "^1.32.0",
    "netlify-cli": "^26.0.2",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "tap-spec": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)"
}
